<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.nexhome</groupId>
    <artifactId>nexhome</artifactId>
    <version>1.3.0</version>
    <packaging>jar</packaging>

    <name>NexHome</name>
    <description>一站式内网节点守护工具，面向家庭 / 小型机房服务器，把内网能力安全对外打通</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <netty.version>4.2.19.Final</netty.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Netty 多模块版本对齐：仅代理中心模块使用，避免只升了一半模块 -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-bom</artifactId>
                <version>${netty.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.53.4.0</version>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.14.0</version>
        </dependency>
        <!-- Web 服务框架：单端口同时提供 REST 接口与内嵌前端静态资源 -->
        <dependency>
            <groupId>io.javalin</groupId>
            <artifactId>javalin</artifactId>
            <version>7.2.3</version>
        </dependency>
        <dependency>
            <groupId>org.shredzone.acme4j</groupId>
            <artifactId>acme4j-client</artifactId>
            <version>5.1.0</version>
        </dependency>
        <!-- acme4j 的 CSR 构造(CSRBuilder)需要 BouncyCastle，仅证书申请链路使用。
             BC 三件套(bcprov/bcpkix/bcutil)必须同版本：acme4j 传递依赖会带入较旧的 bcprov，
             若与 bcpkix 主版本不一致会在运行时抛 NoClassDefFoundError（如 IANAObjectIdentifiers），
             故显式锁定 bcprov/bcutil 与 bcpkix 同版本，直接声明可覆盖 acme4j 的传递版本。 -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcutil-jdk18on</artifactId>
            <version>1.86</version>
        </dependency>
        <!-- acme4j 使用 slf4j 门面，绑定 JDK 内置日志，避免额外引入 logback/log4j -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>2.0.20</version>
        </dependency>
        <!-- 告警通知中心 email 渠道：Jakarta Mail API + Eclipse Angus 实现（SMTP/STARTTLS/SMTPS）。
             angus-mail 传递引入 jakarta.mail-api 与 angus-activation，此处显式声明锁定版本。 -->
        <dependency>
            <groupId>jakarta.mail</groupId>
            <artifactId>jakarta.mail-api</artifactId>
            <version>2.1.5</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>angus-mail</artifactId>
            <version>2.0.5</version>
        </dependency>
        <!-- 反向代理中心转发引擎：只取必要模块（HTTP/1.1 与 HTTP/2 编解码、SSL/SNI、传输）。
             ALPN 走 JDK 内置能力（JDK9+ SSLParameters.setApplicationProtocols），
             无需 tcnative/boringssl；无需 native transport，JDK NIO 通道即可。 -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-codec-http2</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-handler</artifactId>
        </dependency>
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-transport</artifactId>
        </dependency>
        <!-- ip2region：离线 IP 归属地库（xdb 库文件随包内置，外部可覆盖），
             解析代理访问客户端 IP 为“国家/省/市”，无在线接口依赖 -->
        <dependency>
            <groupId>org.lionsoul</groupId>
            <artifactId>ip2region</artifactId>
            <version>3.3.7</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>nexhome</finalName>
        <resources>
            <!-- 仅对 app.properties 做过滤，构建期把 pom.xml 版本号注入进去 -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>app.properties</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>app.properties</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
                <configuration>
                    <release>25</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>
            <!-- 打成单个可执行 fat-jar：java -jar nexhome.jar -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.nexhome.NexHomeApp</mainClass>
                                </transformer>
                                <!-- 合并 acme4j / slf4j 的 ServiceLoader 描述文件 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <!-- Jakarta Mail 的协议能力按 META-INF/mailcap 发现（SMTP/STARTTLS 等），
                                     多 jar 各带一份 mailcap，必须追加合并而非相互覆盖，否则运行时找不到 provider。 -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/mailcap</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>META-INF/defaultjsse_providers</resource>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
